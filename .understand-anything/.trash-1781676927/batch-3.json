      "type": "file",
      "name": "writer.py",
      "filePath": "writer/writer.py",
      "summary": "Core font rendering library providing the Writer and CWriter classes for drawing proportional and monospaced fonts onto MicroPython framebuffer-compatible displays, including ePaper.",
      "tags": ["font-rendering", "display", "utility", "service"],
      "complexity": "complex",
      "languageNotes": "Uses MicroPython-specific APIs such as framebuf.FrameBuffer, bytearray_at, and addressof for zero-copy pixel blitting in CWriter."
