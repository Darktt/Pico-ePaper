      "complexity": "moderate"
    },
    {
      "id": "class:scheduler.py:Scheduler",
      "type": "class",
      "name": "Scheduler",
      "filePath": "scheduler.py",
      "lineRange": [14, 77],
      "summary": "Async scheduler that polls the RTC at sub-second intervals, fires named time-based events (minute, hour, day, weather, ntp) to registered async handler callbacks, with deduplication to prevent double-firing.",
