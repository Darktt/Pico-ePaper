    {
      "id": "file:display/canvas.py",
      "type": "file",
      "name": "canvas.py",
      "filePath": "display/canvas.py",
      "summary": "Provides the LandscapeCanvas class that wraps the 3.7\" ePaper framebuffer, handling coordinate transposition (portrait hardware rendered as landscape), partial and full display commits, and PBM image blitting.",
      "tags": ["component", "service", "utility"],
      "complexity": "complex",
      "languageNotes": "Uses MicroPython's framebuf module and includes a viper-accelerated transposition path for performance on the RP2040."
    },
    {
      "id": "class:display/canvas.py:LandscapeCanvas",
      "type": "class",
      "name": "LandscapeCanvas",
      "filePath": "display/canvas.py",
      "lineRange": [100, 230],
      "summary": "Framebuffer subclass that presents a landscape coordinate system over the physically portrait 3.7\" ePaper panel, with full and partial refresh commit methods and PBM sprite blitting support.",
      "tags": ["component", "utility"],
      "complexity": "complex"
    },
    {
      "id": "file:display/fonts.py",
      "type": "file",
      "name": "fonts.py",
      "filePath": "display/fonts.py",
      "summary": "Defines and lazy-loads bitmap font modules used across all display screens, with a graceful fallback helper for missing optional fonts.",
      "tags": ["utility", "configuration"],
      "complexity": "simple"
    },
    {
      "id": "file:display/icons.py",
      "type": "file",
      "name": "icons.py",
      "filePath": "display/icons.py",
      "summary": "Loads PBM monochrome bitmap icons from the filesystem into framebuffer objects, with an LRU cache and a path-existence helper used by screen renderers for weather and WiFi icons.",
      "tags": ["utility", "component"],
      "complexity": "moderate",
      "languageNotes": "Implements a small manual LRU cache (list-based) to limit RAM usage on the memory-constrained RP2040."
    },
