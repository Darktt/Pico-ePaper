      "id": "file:ntp.py",
      "type": "file",
      "name": "ntp.py",
      "filePath": "ntp.py",
      "summary": "Provides a sync() function that queries an NTP server, applies a timezone offset, and sets the hardware RTC on the Pico W.",
      "tags": ["utility", "service"],
      "complexity": "simple",
      "languageNotes": "Uses MicroPython's ntptime module and the machine.RTC class to write the corrected datetime directly to hardware."
    },
    {
      "id": "function:ntp.py:sync",
      "type": "function",
      "name": "sync",
      "filePath": "ntp.py",
      "lineRange": [10, 32],
      "summary": "Fetches current time from an NTP host, adjusts for a configurable timezone offset in minutes, and programs the hardware RTC; returns True on success.",
      "tags": ["utility", "service"],
      "complexity": "moderate"
    },
    {
      "id": "file:scheduler.py",
      "type": "file",
      "name": "scheduler.py",
      "filePath": "scheduler.py",
