  "nodes": [
    {
      "id": "file:app.py",
      "type": "file",
      "name": "app.py",
      "filePath": "app.py",
      "summary": "Central application controller that manages device lifecycle states (AP mode, STA connection, init, run), wires up WiFi, NTP, weather, scheduler, and display subsystems, and drives the async event loop on the Pico W.",
      "tags": ["entry-point", "service", "event-handler", "singleton"],
      "complexity": "complex",
      "languageNotes": "Uses MicroPython asyncio for cooperative multitasking on RP2040 — no threading, all concurrency via async/await and an event loop."
    },
    {
      "id": "class:app.py:App",
      "type": "class",
      "name": "App",
      "filePath": "app.py",
      "lineRange": [84, 303],
      "summary": "Main application class that orchestrates device boot, WiFi negotiation, NTP sync, weather fetching, scheduler callbacks, and ePaper display rendering across its full lifecycle.",
      "tags": ["service", "singleton", "event-handler"],
      "complexity": "complex"
    },
    {
