    {
      "id": "file:mdns.py",
      "type": "file",
      "name": "mdns.py",
      "filePath": "mdns.py",
      "summary": "Project-level mDNS wrapper providing MDNSResponder — a lifecycle-managed facade around the vendored mdns_client library that handles socket conflicts with the Pico W LWIP built-in mDNS, retry logic, and service advertisement for the ePaper device hostname.",
      "tags": ["service", "middleware", "entry-point"],
      "complexity": "complex",
      "languageNotes": "Detects whether the Pico W LWIP firmware's built-in mDNS is already holding the multicast port and gracefully skips the vendored client in that case; patches socket bind to use INADDR_ANY to avoid dual-binding conflicts."
    },
    {
      "id": "class:mdns.py:MDNSResponder",
      "type": "class",
      "name": "MDNSResponder",
      "filePath": "mdns.py",
      "lineRange": [65, 211],
      "summary": "High-level mDNS service manager that wraps Client and Responder with start/stop/restart lifecycle, retry-with-backoff on bind failures, and LWIP conflict detection for the Pico W.",
      "tags": ["service", "middleware", "event-handler"],
      "complexity": "complex"
    },
    {
      "id": "function:mdns.py:_builtin_mdns_holds_port",
      "type": "function",
      "name": "_builtin_mdns_holds_port",
      "filePath": "mdns.py",
      "lineRange": [42, 62],
      "summary": "Probes whether the Pico W LWIP firmware's built-in mDNS responder has already bound port 5353 by attempting a test socket bind and checking for EADDRINUSE.",
      "tags": ["utility", "middleware"],
      "complexity": "moderate"
    },
    {
      "id": "function:mdns.py:_patch_bind_to_any",
      "type": "function",
      "name": "_patch_bind_to_any",
      "filePath": "mdns.py",
      "lineRange": [29, 39],
      "summary": "Monkey-patches the mDNS Client's socket initialization to bind on INADDR_ANY (0.0.0.0) instead of the multicast group address, resolving dual-bind conflicts on MicroPython.",
      "tags": ["utility", "middleware"],
      "complexity": "simple"
    }
