      "name": "discovery.py",
      "filePath": "lib/mdns_client/service_discovery/discovery.py",
      "summary": "mDNS service discovery engine that continuously watches for PTR/SRV/A records, tracks service lifecycles with TTL expiry and refresh, and notifies registered ServiceMonitor observers of additions, updates, and removals.",
      "tags": ["service", "event-handler", "middleware"],
      "complexity": "complex",
      "languageNotes": "Buffers out-of-order A records (IP address responses that arrive before SRV records) and uses gc.collect for memory management on resource-constrained hardware."
