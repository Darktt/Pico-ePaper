  "nodes": [
    {
      "id": "file:writer/ssd1306_setup.py",
      "type": "file",
      "name": "ssd1306_setup.py",
      "filePath": "writer/ssd1306_setup.py",
      "summary": "為 SSD1306 OLED 顯示器提供硬體初始化工具，支援 SPI 與 I2C 兩種介面，並提供軟體/硬體模式切換，供 writer 模組的範例與測試使用。",
      "tags": ["utility", "硬體初始化", "spi", "i2c", "MicroPython"],
      "complexity": "moderate",
      "languageNotes": "使用 MicroPython 的 machine 模組操作 GPIO 腳位，條件式地建立 SPI 或 I2C 匯流排物件，屬於典型嵌入式硬體抽象模式。"
    },
    {
      "id": "function:writer/ssd1306_setup.py:setup",
      "type": "function",
      "name": "setup",
      "filePath": "writer/ssd1306_setup.py",
      "lineRange": [38, 69],
      "summary": "根據 use_spi 與 soft 參數初始化 SSD1306 顯示器，回傳對應的 SSD1306_SPI 或 SSD1306_I2C 物件供上層呼叫使用。",
      "tags": ["utility", "硬體初始化", "工廠函式"],
      "complexity": "moderate"
    },
    {
      "id": "file:writer/writer.py",
      "type": "file",
      "name": "writer.py",
      "filePath": "writer/writer.py",
      "summary": "實作 Writer 與 CWriter 兩個核心類別，提供字型渲染、文字位置控制、自動換行與捲動功能，是整個 writer 子系統的基礎模組。",
      "tags": ["utility", "文字渲染", "顯示器驅動", "MicroPython"],
      "complexity": "complex",
      "languageNotes": "CWriter 繼承自 Writer，並針對彩色顯示器覆寫 _printchar 與 setcolor，利用 MicroPython uctypes 的 bytearray_at 與 addressof 直接操作記憶體以提升渲染效能。"
    },
    {
      "id": "class:writer/writer.py:Writer",
      "type": "class",
      "name": "Writer",
      "filePath": "writer/writer.py",
      "lineRange": [44, 278],
      "summary": "單色顯示器的文字渲染器，支援字型切換、裁剪區域設定、字串長度量測、Tab 與換行處理，以及逐字元 blit 至 framebuffer。",
      "tags": ["文字渲染", "顯示器驅動", "utility"],
      "complexity": "complex"
    },
    {
      "id": "class:writer/writer.py:CWriter",
      "type": "class",
      "name": "CWriter",
      "filePath": "writer/writer.py",
      "lineRange": [282, 331],
      "summary": "Writer 的彩色擴充子類別，新增 create_color 靜態方法與覆寫後的 _printchar，透過調色盤機制支援前景／背景色的彩色文字渲染。",
      "tags": ["文字渲染", "彩色顯示", "顯示器驅動"],
      "complexity": "moderate"
    },
    {
      "id": "class:writer/writer.py:DisplayState",
      "type": "class",
      "name": "DisplayState",
      "filePath": "writer/writer.py",
      "lineRange": [31, 34],
      "summary": "輕量的顯示器狀態容器，儲存每個顯示裝置的文字游標列與欄位置，供 Writer 的多裝置狀態管理使用。",
      "tags": ["資料模型", "狀態管理"],
      "complexity": "simple"
    },
    {
      "id": "file:writer/writer_demo.py",
